<c:if test='<%= SessionMessages.contains(request, "securityBugsHelper") %>'>

	<%
	SecurityBugsHelper securityBugsHelper = (SecurityBugsHelper)SessionMessages.get(request, "securityBugsHelper");

	List<SecurityBugsHelper.Issue> issues = null;
	String securityBugsLevel = null;

	if (ListUtil.isNotEmpty(securityBugsHelper.getSev1Issues())) {
		issues = securityBugsHelper.getSev1Issues();
		securityBugsLevel = "SEV-1";
	}
	else if (ListUtil.isNotEmpty(securityBugsHelper.getSev2Issues())) {
		issues = securityBugsHelper.getSev2Issues();
		securityBugsLevel = "SEV-2";
	}
	else if (ListUtil.isNotEmpty(securityBugsHelper.getSev3Issues())) {
		issues = securityBugsHelper.getSev3Issues();
		securityBugsLevel = "SEV-3";
	}
	%>

	<c:if test="<%= issues != null %>">

		<%
		String securityBugsIssues = issues.stream().map(
			issue -> issue.getKey()
		).map(
			issueKey -> StringBundler.concat("<a href='https://issues.liferay.com/browse/", issueKey, "' >", issueKey, "</a>")
		).collect(
			Collectors.joining(StringPool.COMMA_AND_SPACE)
		);

		int securityBugsNewFixpack = issues.stream().mapToInt(
			issue -> issue.getFixpack()
		).max(
		).orElse(
			0
		);
		%>

		<liferay-ui:message arguments="<%= new String[] {securityBugsLevel, securityBugsIssues} %>" key="security-vulnerabilities-not-fixed-x-x" /><br />
		<liferay-ui:message arguments="<%= securityBugsNewFixpack %>" key="security-vulnerabilities-update-to-fixpack-x" />
	</c:if>
</c:if>