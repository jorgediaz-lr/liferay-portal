package routines;

import routines.system.JSONArray;
import routines.system.JSONObject;

/**
 * @author Amos Fong
 */
public class ContactRoleParser {

	public static String getAccountRoleId(String externalLinks) {
		if ((externalLinks == null) || externalLinks.isEmpty()) {
			return "";
		}

		JSONArray jsonArray = new JSONArray(externalLinks);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			String domain = jsonObject.getString("domain");
			String entityName = jsonObject.getString("entityName");
			String entityId = jsonObject.getString("entityId");

			if (domain.equals("customer-2.0") &&
				entityName.equals("account-role")) {

				return entityId;
			}
		}

		return "";
	}

}