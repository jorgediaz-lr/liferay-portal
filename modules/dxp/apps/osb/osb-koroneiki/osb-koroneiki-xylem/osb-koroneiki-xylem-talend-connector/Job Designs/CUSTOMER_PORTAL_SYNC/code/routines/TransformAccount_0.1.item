package routines;

import java.util.Date;

import routines.system.JSONArray;
import routines.system.JSONObject;

/**
 * @author Amos Fong
 */
public class TransformAccount {

	public static final String STATUS_CANCELLED = "Cancelled";

	public static String getSLACurrent(String productPurchases)
		throws Exception {

		JSONObject slaJSONObject = null;

		JSONArray jsonArray = new JSONArray(productPurchases);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			if (!_isSLAProduct(jsonObject)) {
				continue;
			}

			Date startDate = DateUtil.parseStartDate(jsonObject);
			Date endDate = DateUtil.parseEndDate(jsonObject);
			String status = jsonObject.getString("status");

			if (!_isActive(startDate, endDate, status)) {
				continue;
			}

			if (_isHigherSLA(slaJSONObject, jsonObject)) {
				slaJSONObject = jsonObject;
			}
		}

		if (slaJSONObject != null) {
			JSONObject productJSONObject = slaJSONObject.getJSONObject(
				"product");

			return productJSONObject.getString("name");
		}

		return "";
	}

	public static String getSLACurrentEndDate(String productPurchases)
		throws Exception {

		String slaCurrent = getSLACurrent(productPurchases);

		Date slaCurrentEndDate = null;

		JSONArray jsonArray = new JSONArray(productPurchases);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			JSONObject productJSONObject = jsonObject.getJSONObject("product");

			if (!slaCurrent.equals(productJSONObject.getString("name"))) {
				continue;
			}

			String status = jsonObject.getString("status");

			if (!_isActive(status)) {
				continue;
			}

			Date endDate = DateUtil.parseEndDate(jsonObject);

			if ((slaCurrentEndDate == null) ||
				slaCurrentEndDate.before(endDate)) {

				slaCurrentEndDate = endDate;
			}
		}

		return DateUtil.format(slaCurrentEndDate);
	}

	public static String getSLACurrentStartDate(String productPurchases)
		throws Exception {

		String slaCurrent = getSLACurrent(productPurchases);

		Date slaCurrentStartDate = null;

		JSONArray jsonArray = new JSONArray(productPurchases);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			JSONObject productJSONObject = jsonObject.getJSONObject("product");

			if (!slaCurrent.equals(productJSONObject.getString("name"))) {
				continue;
			}

			String status = jsonObject.getString("status");

			if (!_isActive(status)) {
				continue;
			}

			Date startDate = DateUtil.parseStartDate(jsonObject);

			if ((slaCurrentStartDate == null) ||
				slaCurrentStartDate.after(startDate)) {

				slaCurrentStartDate = startDate;
			}
		}

		return DateUtil.format(slaCurrentStartDate);
	}

	public static String getSLAFuture(String productPurchases)
		throws Exception {

		String slaCurrent = getSLACurrent(productPurchases);

		JSONObject slaJSONObject = null;

		JSONArray jsonArray = new JSONArray(productPurchases);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			if (!_isSLAProduct(jsonObject)) {
				continue;
			}

			JSONObject productJSONObject = jsonObject.getJSONObject("product");

			if (slaCurrent.equals(productJSONObject.getString("name"))) {
				continue;
			}

			Date endDate = DateUtil.parseEndDate(jsonObject);
			String status = jsonObject.getString("status");

			if (!_isActiveFuture(endDate, status)) {
				continue;
			}

			if (_isHigherSLA(slaJSONObject, jsonObject)) {
				slaJSONObject = jsonObject;
			}
		}

		if (slaJSONObject != null) {
			JSONObject productJSONObject = slaJSONObject.getJSONObject(
				"product");

			return productJSONObject.getString("name");
		}

		return "";
	}

	public static String getSLAFutureEndDate(String productPurchases)
		throws Exception {

		String slaFuture = getSLAFuture(productPurchases);

		Date slaFutureEndDate = null;

		JSONArray jsonArray = new JSONArray(productPurchases);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			JSONObject productJSONObject = jsonObject.getJSONObject("product");

			if (!slaFuture.equals(productJSONObject.getString("name"))) {
				continue;
			}

			String status = jsonObject.getString("status");

			if (!_isActive(status)) {
				continue;
			}

			Date endDate = DateUtil.parseEndDate(jsonObject);

			if ((slaFutureEndDate == null) ||
				slaFutureEndDate.before(endDate)) {

				slaFutureEndDate = endDate;
			}
		}

		return DateUtil.format(slaFutureEndDate);
	}

	public static String getSLAFutureStartDate(String productPurchases)
		throws Exception {

		String slaFuture = getSLAFuture(productPurchases);

		Date slaFutureStartDate = null;

		JSONArray jsonArray = new JSONArray(productPurchases);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			JSONObject productJSONObject = jsonObject.getJSONObject("product");

			if (!slaFuture.equals(productJSONObject.getString("name"))) {
				continue;
			}

			String status = jsonObject.getString("status");

			if (!_isActive(status)) {
				continue;
			}

			Date startDate = DateUtil.parseStartDate(jsonObject);

			if ((slaFutureStartDate == null) ||
				slaFutureStartDate.before(startDate)) {

				slaFutureStartDate = startDate;
			}
		}

		return DateUtil.format(slaFutureStartDate);
	}

	private static boolean _contains(String[] array, String value) {
		for (String s : array) {
			if (s.equals(value)) {
				return true;
			}
		}

		return false;
	}

	private static int _getSLARank(JSONObject productJSONObject)
		throws Exception {

		String productName = productJSONObject.getString("name");

		if (productName.equals(ProductConstants.NAME_GOLD)) {
			return 3;
		}
		else if (productName.equals(ProductConstants.NAME_LIMITED)) {
			return 1;
		}
		else if (productName.equals(ProductConstants.NAME_PLATINUM)) {
			return 4;
		}
		else if (productName.equals(ProductConstants.NAME_SILVER)) {
			return 2;
		}

		return 0;
	}

	private static boolean _isActive(
			Date startDate, Date endDate, String status)
		throws Exception {

		if (!_isActive(status)) {
			return false;
		}

		Date now = new Date();

		if ((startDate != null) && now.before(startDate)) {
			return false;
		}

		if ((endDate != null) && now.after(endDate)) {
			return false;
		}

		return true;
	}

	private static boolean _isActive(String status) throws Exception {
		if ((status == null) || status.equals(STATUS_CANCELLED)) {
			return false;
		}

		return true;
	}

	private static boolean _isActiveFuture(Date endDate, String status)
		throws Exception {

		if (!_isActive(status)) {
			return false;
		}

		Date now = new Date();

		if ((endDate != null) && now.before(endDate)) {
			return false;
		}

		return true;
	}

	private static boolean _isHigherSLA(
			JSONObject curJSONObject, JSONObject jsonObject)
		throws Exception {

		if (curJSONObject == null) {
			return true;
		}

		int curSLARank = _getSLARank(jsonObject.getJSONObject("product"));
		int slaRank = _getSLARank(jsonObject.getJSONObject("product"));

		if (slaRank > curSLARank) {
			return true;
		}

		if (slaRank < curSLARank) {
			return false;
		}

		if (curJSONObject.getBoolean("perpetual") &&
			!jsonObject.getBoolean("perpetual")) {

			return true;
		}

		if (curJSONObject.getBoolean("perpetual")) {
			return false;
		}

		Date curEndDate = DateUtil.parseEndDate(curJSONObject);
		Date endDate = DateUtil.parseStartDate(curJSONObject);

		if (endDate.after(curEndDate)) {
			return true;
		}

		return false;
	}

	private static boolean _isSLAProduct(JSONObject jsonObject) {
		JSONObject productJSONObject = jsonObject.getJSONObject("product");

		String productName = productJSONObject.getString("name");

		if (_contains(ProductConstants.NAMES_SUBSCRIPTION, productName)) {
			return true;
		}

		return false;
	}

}