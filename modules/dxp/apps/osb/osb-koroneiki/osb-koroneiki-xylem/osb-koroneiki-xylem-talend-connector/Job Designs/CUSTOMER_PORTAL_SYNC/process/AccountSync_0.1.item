  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="128" posY="32">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="if (context.lastRunStartDate != null) {&#xA;&#x9;String sanitizedLastRunStartDate = context.lastRunStartDate.trim();&#xA;&#xA;&#x9;if (!sanitizedLastRunStartDate.isEmpty()) {&#xA;&#x9;&#x9;if (context.deltaMins == null) {&#xA;&#x9;&#x9;&#x9;context.deltaMins = 5;&#xA;&#x9;&#x9;}&#xA;&#xA;&#x9;&#x9;Date date = TalendDate.parseDate(&quot;yyyy-MM-dd'T'HH:mm:ssZ&quot;, sanitizedLastRunStartDate);&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;date = new Date(date.getTime() - (context.deltaMins * 60 * 1000));&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;context.lastRunStartDate = TalendDate.formatDate(&#xA;&#x9;&#x9;&#x9;&quot;yyyy-MM-dd'T'HH:mm:ss'Z'&quot;, date);&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;System.out.printf(&#xA;&#x9;&#x9;&#x9;&quot;Importing account data modified after %s%n&quot;, context.lastRunStartDate);&#xA;&#x9;}&#xA;&#x9;else {&#xA;&#x9;&#x9;context.lastRunStartDate = null;&#xA;&#x9;}&#xA;}&#xA;&#xA;if (context.lastRunStartDate == null) {&#xA;&#x9;System.out.println(&quot;Importing all account data&quot;);&#xA;}&#xA;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="import java.util.Date;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
