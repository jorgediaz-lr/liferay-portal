package routines;

import java.text.DateFormat;
import java.text.SimpleDateFormat;

import java.util.Date;

import routines.system.JSONObject;

/**
 * @author Amos Fong
 */
public class DateUtil {

	public static String format(Date date) {
		if (date == null) {
			return "";
		}

		return _simpleDateFormat.format(date);
	}

	public static Date parseEndDate(JSONObject jsonObject) throws Exception {
		String dateString = jsonObject.optString("endDate");

		if (dateString.isEmpty()) {
			return new Date(Constants.END_DATE_PERPETUAL);
		}

		DateFormat dateFormat = new SimpleDateFormat(Constants.DATE_PATTERN);

		return dateFormat.parse(dateString);
	}

	public static Date parseOriginalEndDate(JSONObject jsonObject)
		throws Exception {

		String dateString = jsonObject.optString("originalEndDate");

		if (dateString.isEmpty()) {
			return new Date(Constants.END_DATE_PERPETUAL);
		}

		DateFormat dateFormat = new SimpleDateFormat(Constants.DATE_PATTERN);

		return dateFormat.parse(dateString);
	}

	public static Date parseStartDate(JSONObject jsonObject) throws Exception {
		String dateString = jsonObject.optString("startDate");

		if (dateString.isEmpty()) {
			return new Date(Constants.START_DATE_PERPETUAL);
		}

		DateFormat dateFormat = new SimpleDateFormat(Constants.DATE_PATTERN);

		return dateFormat.parse(dateString);
	}

	private static final SimpleDateFormat _simpleDateFormat =
		new SimpleDateFormat(Constants.DATE_PATTERN);

}